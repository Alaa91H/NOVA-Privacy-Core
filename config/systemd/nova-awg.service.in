[Unit]
Description=NOVA Privacy Core AmneziaWG userspace tunnel
After=network-online.target
Wants=network-online.target
Before=nova-adguard-private.service nova-adguard-strict.service

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=WG_QUICK_USERSPACE_IMPLEMENTATION=/usr/local/sbin/amneziawg-go
Environment=LOG_LEVEL=error
ExecStart=/usr/bin/awg-quick up @@AWG_CONFIG@@
ExecStop=/usr/bin/awg-quick down @@AWG_CONFIG@@
TimeoutStartSec=45
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
