[Unit]
Description=NOVA encrypted-DNS IPv4 set refresh
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/nova-privacy/scripts/update-doh-ips.sh
UMask=0022
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadWritePaths=/var/lib/nova-privacy/doh /etc/nova-privacy/nftables
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
