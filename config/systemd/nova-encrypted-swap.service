[Unit]
Description=NOVA ephemeral encrypted disk swap
DefaultDependencies=no
After=local-fs.target systemd-udev-settle.service
Before=swap.target multi-user.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/nova-privacy/scripts/encrypted-swap.sh start
ExecStop=/opt/nova-privacy/scripts/encrypted-swap.sh stop
TimeoutStartSec=60
TimeoutStopSec=60

[Install]
WantedBy=swap.target
