#!/usr/sbin/nft -f

destroy table inet nova

table inet nova {
  set compat4 {
    type ipv4_addr
    elements = { @@COMPAT_ELEMENTS@@ }
  }

  set strict4 {
    type ipv4_addr
    elements = { @@STRICT_ELEMENTS@@ }
  }

  set management4 {
    type ipv4_addr
    elements = { @@MGMT_ELEMENTS@@ }
  }

  set lockdown4 {
    type ipv4_addr
    elements = { @@LOCKDOWN_ELEMENTS@@ }
  }

  set doh4 {
    type ipv4_addr
    elements = { @@DOH_IP_ELEMENTS@@ }
  }

  chain dns_redirect {
    type nat hook prerouting priority dstnat; policy accept;

    iifname "@@VPN_IF@@" ip saddr @compat4 udp dport 53 redirect to :@@UNBOUND_PORT@@
    iifname "@@VPN_IF@@" ip saddr @compat4 tcp dport 53 redirect to :@@UNBOUND_PORT@@

    iifname "@@VPN_IF@@" ip saddr @strict4 udp dport 53 redirect to :@@STRICT_DNS_PORT@@
    iifname "@@VPN_IF@@" ip saddr @strict4 tcp dport 53 redirect to :@@STRICT_DNS_PORT@@

    iifname "@@VPN_IF@@" ip saddr { @@VPN_NET@@, @@MGMT_NET@@ } udp dport 53 redirect to :@@PRIVATE_DNS_PORT@@
    iifname "@@VPN_IF@@" ip saddr { @@VPN_NET@@, @@MGMT_NET@@ } tcp dport 53 redirect to :@@PRIVATE_DNS_PORT@@
  }

  chain input {
    type filter hook input priority filter; policy drop;

    ct state invalid drop
    iifname "@@VPN_IF@@" ip saddr @lockdown4 drop
    ct state established,related accept
    iifname "lo" accept

    ip protocol icmp accept
    ip6 nexthdr ipv6-icmp accept

    # DHCP lease renewal on cloud/VPS networks.  The reply may arrive before
    # conntrack has a useful state after boot, so keep this explicit.
    iifname "@@WAN_IF@@" udp sport 67 udp dport 68 accept

    iifname "@@WAN_IF@@" udp dport @@AWG_PORT@@ accept
@@BOOTSTRAP_SSH_RULE@@

    iifname "@@VPN_IF@@" ip saddr { @@VPN_NET@@, @@MGMT_NET@@ } udp dport { @@PRIVATE_DNS_PORT@@, @@STRICT_DNS_PORT@@, @@UNBOUND_PORT@@ } accept
    iifname "@@VPN_IF@@" ip saddr { @@VPN_NET@@, @@MGMT_NET@@ } tcp dport { @@PRIVATE_DNS_PORT@@, @@STRICT_DNS_PORT@@, @@UNBOUND_PORT@@ } accept

    iifname "@@VPN_IF@@" ip saddr @management4 tcp dport 22 accept
  }

  chain forward {
    type filter hook forward priority filter; policy drop;

    ct state invalid drop
    iifname "@@VPN_IF@@" ip saddr @lockdown4 drop
@@TRAFFIC_GATE_DROP@@
    iifname "@@VPN_IF@@" ip saddr @strict4 ip daddr @doh4 drop
    iifname "@@VPN_IF@@" ip saddr { @@VPN_NET@@, @@MGMT_NET@@ } tcp dport 853 drop
    iifname "@@VPN_IF@@" ip saddr { @@VPN_NET@@, @@MGMT_NET@@ } udp dport 853 drop
    ct state established,related accept

    iifname "@@VPN_IF@@" oifname "@@WAN_IF@@" ip saddr { @@VPN_NET@@, @@MGMT_NET@@ } accept
  }

  chain output {
    type filter hook output priority filter; policy drop;

    ct state invalid drop
    ct state established,related accept
    oifname "lo" accept

    ip protocol icmp accept
    ip6 nexthdr ipv6-icmp accept

    # Keep the cloud interface alive under a default-drop OUTPUT policy.
    oifname "@@WAN_IF@@" udp sport 68 udp dport 67 accept

    # Minimal host egress required for recursive DNS, NTP, package/security
    # downloads, release verification and HTTPS APIs.
    udp dport { 53, 123, 443 } accept
    tcp dport { 53, 80, 443 } accept
  }

  chain postrouting {
    type nat hook postrouting priority srcnat; policy accept;
    oifname "@@WAN_IF@@" ip saddr { @@VPN_NET@@, @@MGMT_NET@@ } masquerade
  }
}
